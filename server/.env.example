PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# iTunes Search API is free and needs no key. Country = which storefront/charts to use (us, in, gb...)
MUSIC_COUNTRY=us
CACHE_TTL_SECONDS=300

# Uploaded full-length songs
MAX_UPLOAD_MB=60

# Supabase Postgres connection string (keep this secret, never commit it).
# Supabase dashboard -> your project -> "Connect" -> "Session pooler" -> copy the URI,
# replace [YOUR-PASSWORD] with your database password (URL-encode special characters like @ as %40).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:5432/postgres
